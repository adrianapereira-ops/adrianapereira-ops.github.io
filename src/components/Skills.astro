---
const skills = [
  {
    category: "Lenguajes & Desarrollo",
    items: ["Java", "HTML5", "CSS", "JavaScript", "Astro"]
  },
  {
    category: "Bases de Datos & Entorno",
    items: ["SQL", "MySQL / MariaDB", "Git", "GitHub", "VS Code"]
  },
  {
    category: "Habilidades clave",
    items: ["Diseño UI", "Idiomas", "Trabajo en equipo", "Resolución de problemas"]
  }
];
---

<div class="skills-container">
    <h2>Habilidades & Tecnologías</h2>
    <div class="separador"></div>

    <div class="skills-grid">
        {skills.map((group) => (
            <div class="skill-card">
                <h3>{group.category}</h3>
                <div class="tags">
                    {group.items.map((skill) => (
                        <span class="tag">{skill}</span>
                    ))}
                </div>
            </div>
        ))}
    </div>
</div>

<style>
.skills-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
    font-family: Inter, Roboto, Arial, sans-serif;
}

.skills-container h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 600;
}

.separador {
    width: 60px;
    height: 2px;
    background: currentColor;
    margin: 15px 0 30px 0;
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.skill-card {
    background: rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
}

.skill-card h3 {
    margin: 0 0 15px 0;
    font-size: 18px;
    font-weight: 600;
    color: #111827;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.tag {
    background: rgba(240, 65, 255, 0.1);
    color: #a81d85;
    border: 1px solid rgba(240, 65, 255, 0.25);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
}
</style>