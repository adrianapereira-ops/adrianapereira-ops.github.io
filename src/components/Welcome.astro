
---
---

<div id="portada">
    <header class="topbar">
        <div class="availability">
            <span class="status-dot"></span>
            <span>Disponible para nuevas oportunidades</span>
        </div>

        <nav class="navigation" aria-label="Navegación principal">
            <a class="nav-link active" href="#portada">Inicio</a>
            <a class="nav-link" href="#sobre-mi">Sobre mí</a>
            <a class="nav-link" href="#proyectos">Proyectos</a>
            <a class="nav-link" href="#formacion">Formación</a>
            <a class="nav-link" href="#contacto">Contacto</a>
        </nav>
    </header>

    <main class="hero">
        <div class="hero-content">
            <p class="eyebrow">¡Hola! Bienvenido/a a mi portfolio</p>

            <h1>Adriana Pereira Domènech</h1>

            <h2>Estudiante de DAM y futura desarrolladora.</h2>

            <p class="description">
                Aprendiendo, creando proyectos y convirtiendo ideas en aplicaciones.
            </p>

            <div class="sparkles" aria-hidden="true">
                <span class="sparkle sparkle-one">✦</span>
                <span class="sparkle sparkle-two">✧</span>
                <span class="sparkle sparkle-three">✦</span>
            </div>
        </div>
    </main>

    <footer class="hero-footer">
        <span>Diseñado y desarrollado por Adriana</span>
        <span>Portfolio personal · 2026</span>
    </footer>
</div>

<style>
    #portada {
        position: relative;
        min-height: 100vh;
        min-height: 100svh;
        box-sizing: border-box;
        padding: 20px 3%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background:
            radial-gradient(ellipse at 15% 15%, rgba(255, 218, 239, 0.72), transparent 48%),
            radial-gradient(ellipse at 80% 18%, rgba(213, 192, 255, 0.72), transparent 48%),
            radial-gradient(ellipse at 52% 75%, rgba(199, 220, 255, 0.68), transparent 52%),
            linear-gradient(120deg, #fbf5fc, #f2edff 52%, #fceafa);
        font-family: Inter, Roboto, Arial, sans-serif;
    }

    .topbar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 20px;
        width: 100%;
        z-index: 1;
    }

    .availability {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #5d5865;
        font-size: 13px;
    }

    .status-dot {
        width: 9px;
        height: 9px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #17151c;
    }

    .navigation {
        display: flex;
        align-items: center;
        gap: 2px;
        padding: 5px;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.95);
        border-radius: 999px;
        box-shadow: 0 5px 24px rgba(92, 65, 120, 0.08);
        backdrop-filter: blur(16px);
    }

    .nav-link {
        padding: 12px 17px;
        border-radius: 999px;
        color: #514d58;
        text-decoration: none;
        font-size: 13px;
        white-space: nowrap;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .nav-link:hover,
    .nav-link.active {
        background: #ded6ff;
        color: #252033;
    }

    .hero {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 70px 20px;
    }

    .hero-content {
        position: relative;
        max-width: 850px;
    }

    .eyebrow {
        margin: 0 0 18px;
        color: #75658e;
        font-size: 14px;
        letter-spacing: 0.04em;
    }

    .hero h1 {
        margin: 0 0 12px;
        color: #17151c;
        font-size: clamp(34px, 5vw, 58px);
        line-height: 1.15;
        letter-spacing: -0.045em;
        font-weight: 750;
    }

    .hero h2 {
        margin: 0 0 22px;
        color: #24212b;
        font-size: clamp(19px, 2.7vw, 28px);
        line-height: 1.4;
        font-weight: 600;
    }

    .description {
        max-width: 600px;
        margin: 0 auto;
        color: #625d6b;
        font-size: 16px;
        line-height: 1.8;
    }

    .sparkles {
        position: absolute;
        inset: -45px -35px;
        pointer-events: none;
    }

    .sparkle {
        position: absolute;
        color: #a98de8;
        animation: twinkle 3s ease-in-out infinite;
    }

    .sparkle-one {
        top: 12%;
        right: 4%;
        font-size: 24px;
    }

    .sparkle-two {
        top: 72%;
        left: 2%;
        font-size: 30px;
        animation-delay: 0.8s;
    }

    .sparkle-three {
        top: 3%;
        left: 12%;
        font-size: 15px;
        animation-delay: 1.5s;
    }

    .hero-footer {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        color: #777180;
        font-size: 12px;
        padding: 10px 0 2px;
    }

    @keyframes twinkle {
        0%, 100% {
            opacity: 0.45;
            transform: scale(0.85) rotate(0deg);
        }
        50% {
            opacity: 1;
            transform: scale(1.15) rotate(12deg);
        }
    }

    @media (max-width: 850px) {
        .topbar {
            grid-template-columns: 1fr;
            justify-items: center;
            gap: 18px;
        }

        .availability {
            justify-self: start;
        }

        .navigation {
            max-width: 100%;
            overflow-x: auto;
        }

        .nav-link {
            padding: 11px 13px;
        }

        .hero {
            padding: 65px 8px;
        }
    }

    @media (max-width: 480px) {
        #portada {
            padding: 18px 14px;
        }

        .navigation {
            width: 100%;
            box-sizing: border-box;
            justify-content: flex-start;
        }

        .nav-link {
            padding: 10px 11px;
            font-size: 12px;
        }

        .hero-footer {
            flex-direction: column;
            text-align: center;
        }

        .sparkles {
            inset: -35px -10px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .sparkle {
            animation: none;
        }
    }
</style>
